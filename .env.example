# Copy to .env. Never commit .env. Seed tokens are public fake fixtures.
LLM_PROVIDER=fake            # fake (default, offline) | openrouter
LLM_MODEL=
VERIFIER_MODEL=              # optional, defaults to LLM_MODEL
OPENROUTER_API_KEY=          # optional, only for LLM_PROVIDER=openrouter
LANGCHAIN_TRACING_V2=false

STORE_URL=http://localhost:8001
A2A_PUBLIC_URL=http://localhost:8002
DB_PATH=./data/orchestrator.db        # orchestrator SQLite file
STORE_DB_PATH=./data/store.db         # store SQLite file (tests use a temp path or :memory:)
STORE_RESEED=false
PROPOSAL_TTL_SECONDS=900
INCLUDE_NOTES=false
